{
  "crons": [
    {
      "path": "/api/cron-verificar-vencimentos",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron-testes",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/cron-verificar-vencimentos.js": {
      "maxDuration": 60
    },
    "api/cron-testes.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/criar-revendedor",
      "destination": "/api/revenda-operations?operacao=criar-revendedor"
    },
    {
      "source": "/api/gerenciar-revendedor",
      "destination": "/api/revenda-operations?operacao=gerenciar-revendedor"
    },
    {
      "source": "/api/impersonar-revendedor",
      "destination": "/api/revenda-operations?operacao=impersonar-revendedor"
    },
    {
      "source": "/api/pagar-comissao",
      "destination": "/api/revenda-operations?operacao=pagar-comissao"
    },
    {
      "source": "/api/push-manual-revendedor",
      "destination": "/api/revenda-operations?operacao=push-manual-revendedor"
    },
    {
      "source": "/api/meus-chamados",
      "destination": "/api/revenda-operations?operacao=meus-chamados"
    },
    {
      "source": "/api/meus-indicados",
      "destination": "/api/revenda-operations?operacao=meus-indicados"
    },
    {
      "source": "/api/minhas-comissoes",
      "destination": "/api/revenda-operations?operacao=minhas-comissoes"
    }
  ]
}
